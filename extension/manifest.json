{
  "manifest_version": 3,
  "name": "GLDN Ops",
  "version": "3.12.21",
  "description": "Workflow assistant for internal marketplace operations.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "debugger",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://*.amazon.com/*",
    "https://*.walmart.com/*",
    "https://*.poshmark.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://ecomsniper.io/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "profit-audit.js",
        "profit-backfill.js",
        "sniping-audit.js",
        "subscribe-save.js",
        "amazon.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.walmart.com/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "walmart.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ebay.com/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "profit-audit.js",
        "ebay-profit-core.js",
        "sniping-audit.js",
        "ebay.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.poshmark.com/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "profit-audit.js",
        "profit-backfill.js",
        "poshmark.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ecomsniper.io/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "ecomsniper.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*.amazon.com/*",
        "https://*.walmart.com/*",
        "https://*.ebay.com/*",
        "https://*.poshmark.com/*",
        "https://ecomsniper.io/*"
      ],
      "js": [
        "config.example.js",
        "theme-catalog.js",
        "foundation.js",
        "shared.js",
        "control-heartbeat.js",
        "universal.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GLDN Ops",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "open-ebay-daily-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+G"
      },
      "description": "Open GLDN Ops daily actions on eBay"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
